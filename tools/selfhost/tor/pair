#!/bin/sh
# Prints the code Kilonova scans to use this node and server (Settings,
# Pair with your server). Anyone with it can use your server and send it a
# wallet's view key, so show it only to your own devices.
set -eu
host_file=/var/lib/tor/kilonova/hostname
for _ in $(seq 1 60); do
  [ -s "$host_file" ] && break
  sleep 1
done
if [ ! -s "$host_file" ]; then
  echo "Tor has not created the onion address yet. Is the tor service running?" >&2
  exit 1
fi
onion=$(cat "$host_file")
if [ "${1:-}" = "--hostname" ]; then
  echo "$onion"
  exit 0
fi
enc() { printf '%s' "$1" | sed 's/:/%3A/g; s#/#%2F#g'; }
# push: ntfy for payment pushes (see push-register); older Kilonova
# versions ignore it.
code="kilonova-server:?network=${KN_NETWORK:-mainnet}&node=$(enc "http://$onion:18089")&lws=$(enc "http://$onion:8443")&push=$(enc "http://$onion")"
echo "$code"
echo
qrencode -t ANSIUTF8 "$code"
